{
    "editor.wrappingIndent": "deepIndent",
    "editor.wordWrapColumn": 50,
    "editor.wrappingStrategy": "advanced",
    "editor.wordWrap": "on",
    "debug.console.fontSize": 13,
    "terminal.integrated.fontSize": 13,
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.python"
    },
    "explorer.confirmDelete": false,
    "security.workspace.trust.untrustedFiles": "open",
    "files.autoSave": "afterDelay",
    "zenMode.fullScreen": false,
    "editor.fontFamily": "'SF Mono', Menlo, Monaco, 'Courier New', monospace",
    "debug.console.fontFamily": "Monaco for Powerline",
    "scm.inputFontFamily": "Monaco for Powerline",
    "editor.inlayHints.fontFamily": "Monaco for Powerline",
    "editor.codeLensFontFamily": "Monaco for Powerline",
    "terminal.integrated.fontFamily": "Monaco for Powerline",
    "notebook.output.fontFamily": "Monaco for Powerline",
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.lineNumbers": "off",
    "workbench.editor.showTabs": "single",
    "editor.guides.bracketPairsHorizontal": false,
    "editor.guides.highlightActiveBracketPair": false,
    "editor.guides.indentation": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.fastScrollSensitivity": 0,
    "editor.scrollbar.horizontalScrollbarSize": 0,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "workbench.activityBar.location": "hidden",
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "zenMode.showTabs": "single",
    "workbench.sideBar.location": "right",
    "vscode_custom_css.imports": [
        "file:///.clean_vsc/customs/index.css"
    ],
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.2,
    "workbench.iconTheme": null,
    "explorer.confirmPasteNative": false,
    "rust-analyzer.diagnostics.disabled": [
        "unresolved-proc-macro"
    ],
    "window.zoomLevel": 1,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "workbench.statusBar.visible": false,
    "git.enableStatusBarSync": false,
    "gitlens.statusBar.pullRequests.enabled": false,
    "gitlens.views.workspaces.showUpstreamStatus": false,
    "gitlens.mode.statusBar.enabled": false,
    "gitlens.statusBar.enabled": false,
    "gitlens.views.repositories.showUpstreamStatus": false,
    "gitlens.graph.statusBar.enabled": false,
    "gitlens.graph.showUpstreamStatus": false,
    "gitlens.views.workspaces.avatars": false,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "tabnine.experimentalAutoImports": true,
    "bitoAI.appearance.fontSize (Match with IDE Font)": false,
    "gitlens.codeLens.authors.command": false,
    "customAppIcons.path": "~/Library/Application Support/Code/User/icons",
    "go.goroot": "/opt/homebrew/Cellar/go/1.24.2/libexec",
    "workbench.editor.empty.hint": "hidden",
    "C_Cpp.default.compilerPath": "/usr/bin/clang",
    "python.analysis.indexing": true,
    "python.analysis.autoImportCompletions": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "workbench.colorTheme": "Cursor Dark Core",
    "rust-analyzer.inlayHints.enable": false,
    "rust-analyzer.inlayHints.typeHints.enable": false,
    "rust-analyzer.inlayHints.parameterHints.enable": false,
    "rust-analyzer.inlayHints.chainingHints.enable": false,
    "rust-analyzer.inlayHints.bindingModeHints.enable": false,
    "editor.minimap.enabled": false,
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "editor.inlineSuggest.edits.renderSideBySide": "never",
    "editor.acceptSuggestionOnEnter": "off",
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.nextEditSuggestions.fixes": false,
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
    "editor.inlineSuggest.edits.showLongDistanceHint": false
}